<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    这个文件跟着仓库走,所以**不许写任何本机专属的东西**。

    以前这里写着:
      globalPackagesFolder = G:\DeepSeek DSH\.nuget-packages
      http_proxy / https_proxy = http://127.0.0.1:7890
    CI 上这两样都不存在 —— restore 直接报
    "Could not find a part of the path 'G:\DeepSeek DSH\.nuget-packages\...'",
    于是发版工作流连续八次全挂,最后被人手动关掉了。

    本机要指定缓存目录/走代理,用**环境变量**:
      $env:NUGET_PACKAGES = 'G:\DeepSeek DSH\.nuget-packages'
      $env:HTTP_PROXY = $env:HTTPS_PROXY = 'http://127.0.0.1:7890'
    build-winui.ps1 和 release.ps1 在本机跑的时候会设(且只在那个目录真的存在时才设),
    这些设置不进仓库。
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
