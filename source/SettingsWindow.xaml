<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeepSeekHarnessLauncher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DeepSeekHarnessLauncher"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="大肥鱼Go设置">

    <Grid
        x:Name="SettingsRoot"
        MinWidth="800"
        MinHeight="560"
        Background="Transparent">
        <Grid.Resources>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            <Thickness x:Key="NavigationViewItemButtonMargin">4,1,4,1</Thickness>

            <Style x:Key="SettingsPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsPageDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingsRowGridStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="ColumnSpacing" Value="24" />
            </Style>

            <Style x:Key="SettingsRowTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsAccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsCompactButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsTagPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsStatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsPathBoxStyle" TargetType="TextBox">
                <Setter Property="MinWidth" Value="300" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 插件卡片：本地 / 在线 / 官方推荐共用。标题过长可横向滚动，
                 简介固定两行并省略，按钮行贴在卡片底部，同一行卡片高度齐平。 -->
            <DataTemplate x:Key="PluginCardTemplate" x:DataType="local:PluginCardItem">
                <Border
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 圆形图标：有图标显示图标，没有则露出 GitHub 默认标记 -->
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Source="ms-appx:///assets/plugin-placeholder.svg" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind IconSource}"
                                                Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </ScrollViewer>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind StarsVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Stars}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Height="34"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Background="{x:Bind StatusBackground, Mode=OneWay}"
                                    Style="{StaticResource SettingsStatusPillStyle}"
                                    Visibility="{x:Bind StatusVisibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind StatusForeground, Mode=OneWay}"
                                        Text="{x:Bind Status}" />
                                </Border>
                                <Border Style="{StaticResource SettingsTagPillStyle}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag1}"
                                        Visibility="{x:Bind Tag1Visibility}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag2Visibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag2}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0">
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind LocalActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Tag="{x:Bind}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OpenPluginFolder_Click"
                                    ToolTipService.ToolTip="打开插件目录">
                                    <SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button
                                    Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind CheckEnabled}"
                                    MinWidth="0"
                                    Click="CheckPluginUpdate_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="手动链接的插件不参与更新检查" />
                                <Button
                                    Content="卸载"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="UninstallPlugin_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind OnlineActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="查看详情"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ShowPluginDetail_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                                <Grid
                                    Grid.Column="1"
                                    RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="0"
                                        Tag="{x:Bind}"
                                        Click="InstallOnlinePlugin_Click"
                                        IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}"
                                        Height="32" />
                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="2"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            CornerRadius="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <Image
                    Width="20"
                    Height="20"
                    Source="ms-appx:///assets/DeepSeek-icon.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="大肥鱼Go设置" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.28" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="1"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="208"
            PaneDisplayMode="Left"
            ItemInvoked="SettingsNavigationView_ItemInvoked"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavItem"
                    Content="常规"
                    Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PluginsNavItem"
                    Content="插件"
                    Tag="Plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ComponentsNavItem"
                    Content="组件"
                    Tag="Components">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ThemeNavItem"
                    Content="主题"
                    Tag="Theme">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ApiNavItem"
                    Content="API"
                    Tag="Api">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AlertsNavItem"
                    Content="提醒"
                    Tag="Alerts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ServiceNavItem"
                    Content="服务"
                    Tag="Service">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="UpdatesNavItem"
                    Content="更新"
                    Tag="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavItem"
                    Content="关于"
                    Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="DeveloperNavItem"
                    Content="开发者管理中心"
                    SelectsOnInvoked="False"
                    Tag="Developer"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer
                x:Name="SettingsScroller"
                Padding="20,18,20,38"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="SettingsContentHost"
                    Width="760"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    Spacing="16">

                    <!-- 常规 -->
                    <StackPanel
                        x:Name="GeneralPage"
                        Spacing="16">
                        <TextBlock
                            Style="{StaticResource SettingsPageTitleTextStyle}"
                            Text="常规" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="启动端口" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="选择 DSH 服务的监听端口。" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="14">
                                        <RadioButton
                                            x:Name="RandomPortRadio"
                                            Content="随机端口"
                                            GroupName="StartupPortMode"
                                            Tag="Random"
                                            Checked="PortModeRadio_Checked" />
                                        <RadioButton
                                            x:Name="FixedPortRadio"
                                            Content="固定端口"
                                            GroupName="StartupPortMode"
                                            Tag="Fixed"
                                            Checked="PortModeRadio_Checked" />
                                        <RadioButton
                                            x:Name="DefaultPortRadio"
                                            Content="默认 3080"
                                            GroupName="StartupPortMode"
                                            Tag="Default"
                                            IsChecked="True"
                                            Checked="PortModeRadio_Checked" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    x:Name="FixedPortRow"
                                    ColumnSpacing="16"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="固定端口" />
                                    <NumberBox
                                        x:Name="FixedPortBox"
                                        Grid.Column="1"
                                        Minimum="1024"
                                        Maximum="65535"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        MinWidth="104" Width="104" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Value="8787" />
                                </Grid>

                                <InfoBar
                                    x:Name="DefaultPortWarning"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="使用默认端口可能导致您的 DSH 服务遭受外部攻击。请确认您未使用公网 IP，并确定局域网内无威胁设备。"
                                    Severity="Warning"
                                    Title="安全提示" />
                                <InfoBar
                                    x:Name="PortChangeInfoBar"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="操作将会在下次启动服务时生效。"
                                    Severity="Success"
                                    Title="已保存" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="开机自启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="登录 Windows 后自动启动大肥鱼Go。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsOn="True" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="静默启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="控制启动 DSH 时是否自动打开网页。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="SilentStartComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="全部" Tag="All" />
                                    <ComboBoxItem Content="仅开机自启" Tag="StartupOnly" />
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="在线引擎" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="更新、更新检测和在线插件服务使用的网络入口。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="UpdateSourceComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="大陆 CDN 加速" Tag="Accelerated" />
                                    <ComboBoxItem Content="官方源" Tag="Official" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="插件来源" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="在线插件目录与安装包从哪个入口拉。DSH 插件市场带验证状态与分类信息。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="PluginSourceComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="代理设置" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动器、更新线程与在线插件服务的请求是否走代理。DSH 本体进程不受影响。" />
                                </StackPanel>
                                <RadioButtons
                                    x:Name="ProxyModeSelector"
                                    SelectedIndex="0">
                                    <RadioButton
                                        Content="不使用代理"
                                        Tag="None" />
                                    <RadioButton
                                        Content="使用系统代理"
                                        Tag="System" />
                                    <RadioButton
                                        Content="使用自定义代理"
                                        Tag="Custom" />
                                </RadioButtons>
                                <ContentControl
                                    x:Name="ProxyCustomPanel"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="False">
                                    <StackPanel Spacing="12">
                                    <RadioButtons
                                        x:Name="ProxyProtocolSelector"
                                        Header="代理协议"
                                        MaxColumns="3"
                                        SelectedIndex="0">
                                        <RadioButton
                                            Content="http 代理（推荐）"
                                            Tag="Http" />
                                        <RadioButton
                                            Content="https 代理（代理端 TLS）"
                                            Tag="Https" />
                                        <RadioButton
                                            Content="socks5"
                                            Tag="Socks5" />
                                    </RadioButtons>
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="Clash、V2Ray 等本地代理端口通常选 http 代理；https 代理表示启动器要先和代理服务器建立 TLS 连接。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ProxyHostBox"
                                            Header="代理地址"
                                            PlaceholderText="127.0.0.1"
                                            Text="127.0.0.1" />
                                        <NumberBox
                                            x:Name="ProxyPortBox"
                                            Grid.Column="1"
                                            Header="端口"
                                            Maximum="65535"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="7890"
                                            Width="128" />
                                    </Grid>
