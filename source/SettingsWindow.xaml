                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                        <StackPanel
                                            x:Name="PluginUpdateProgressPanel"
                                            Spacing="6"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                x:Name="PluginUpdateProgressText"
                                                Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                            <ProgressBar
                                                x:Name="PluginUpdateProgressBar"
                                                Height="5" />
                                            <TextBlock
                                                Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                                Text="请不要关闭软件" />
                                        </StackPanel>
                                        <InfoBar
                                            x:Name="PluginUpdateResultInfoBar"
                                            IsClosable="False"
                                            IsOpen="False" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="自动检查周期" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="从上次检查时间开始计算，离线失败后顺延。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="UpdateIntervalComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="每次启动" Tag="EveryStart" />
                                    <ComboBoxItem Content="三天" Tag="ThreeDays" />
                                    <ComboBoxItem Content="七天" Tag="SevenDays" />
                                    <ComboBoxItem Content="一个月" Tag="OneMonth" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 关于 -->
                    <StackPanel
                        x:Name="AboutPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource SettingsPageTitleTextStyle}"
                            Text="关于" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="启动器版本" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="Dafeiyu-Go Launcher" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="VersionText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Tapped="VersionText_Tapped"
                                    Text="v1.4.9.1"
                                    ToolTipService.ToolTip="连续点击五次可打开开发者管理中心" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="GitHub" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="查看项目源码和版本发布记录。" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="OpenGitHub_Click"
                                    Content="打开 GitHub"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="反馈" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="提交问题、功能建议或使用反馈。" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="OpenFeedback_Click"
                                    Content="提交 GitHub Issue"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="日志与诊断" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="打开启动器日志所在目录。" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="OpenLauncherLogs_Click"
                                    Content="打开日志目录"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="16">
                            <TextBlock
                                Margin="0,14,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="关于作者" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="16">
                                    <Border
                                        Width="72"
                                        Height="72"
                                        Background="#303030"
                                        CornerRadius="36">
                                        <Grid>
                                            <ProgressRing
                                                x:Name="AuthorAvatarLoading"
                                                Width="24"
                                                Height="24"
                                                Foreground="White"
                                                IsActive="True" />
                                            <Image
                                                x:Name="AuthorAvatarImage"
                                                Stretch="UniformToFill"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="雨沫云汐" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="大肥鱼Go启动器作者" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="OpenBilibili_Click"
                                        Content="哔哩哔哩"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        Click="OpenDouyin_Click"
                                        Content="抖音"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="支持一下" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="如果这个项目对你有帮助，可以请作者喝杯奶茶。" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="28">
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="180"
                                            Height="180"
                                            Background="White"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <Image
                                                Source="ms-appx:///assets/donate-alipay.jpg"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="支付宝" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="180"
                                            Height="180"
                                            Background="White"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <Image
                                                Source="ms-appx:///assets/donate-wechat.png"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="微信" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <!-- 在线插件详情卡片 -->
        <ContentDialog
            x:Name="PluginDetailDialog"
            Grid.RowSpan="2"
            PrimaryButtonText=""
            SecondaryButtonText=""
            CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer
                MaxHeight="480"
                VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PluginDetailTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="dsh-plugin-store"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PluginDetailAuthor"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="0xKcyzz · 0xKcyzz/dsh-plugin-store" />
                    </StackPanel>
                    <Button
                        x:Name="ClosePluginDetailButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="ClosePluginDetail_Click"
                        Style="{StaticResource SettingsIconButtonStyle}"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stars 312" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="TypeScript" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="MIT" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近更新 2026-09-18" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="PluginDetailDescription"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="在 DSH 设置里新增插件商店，浏览、搜索、筛选并一键安装 dsh-plugin 生态插件。安装后重启 DSH 生效。"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="插件与依赖会以第三方代码的身份在 DSH 里运行，请确认来源可信后再安装。"
                        Severity="Informational"
                        Title="安装来自 GitHub 的第三方插件" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenPluginRepositoryButton"
                        Content="打开 GitHub 仓库"
                        Click="OpenPluginRepository_Click"
                        Style="{StaticResource SettingsActionButtonStyle}" />
                    <Button
                        x:Name="CopyPluginConfigButton"
                        Content="复制配置方式"
                        Click="CopyPluginConfig_Click"
                        Style="{StaticResource SettingsActionButtonStyle}" />
                    <Button
                        x:Name="InstallOnlinePluginButton"
                        Content="安装"
                        Click="InstallDetailPlugin_Click"
                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- 浮动的 GitHub Token 提示：目录接口被限流时出现 -->
        <Grid
            Grid.Row="1"
            Margin="12"
            VerticalAlignment="Bottom">
            <InfoBar
                x:Name="GitHubTokenPromptInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="您需要写入 GitHub Token 以获取更多内容。"
                Severity="Informational"
                Title="GitHub 接口配额已用完">
                <InfoBar.ActionButton>
                    <Button
                        Click="FillGitHubToken_Click"
                        Content="立即填写" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Window>
