<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeepSeekHarnessLauncher</RootNamespace>
    <AssemblyName>DeepSeek Harness</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>DeepSeekHarness.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.3.14</Version>
    <AssemblyVersion>1.3.14.0</AssemblyVersion>
    <FileVersion>1.3.14.0</FileVersion>
    <Product>DeepSeek Harness</Product>
    <Title>DeepSeek Harness</Title>
    <AssemblyTitle>DeepSeek Harness</AssemblyTitle>
    <Authors>Deepseek/KitamaruRamito</Authors>
    <Company>高性能萝卜子鲸鲸有限公司</Company>
    <Description>这是由高性能萝卜子编写的启动高性能萝卜子的启动器喵</Description>
    <Copyright>Copyright © 2026 Deepseek/KitamaruRamito</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Compile Remove="Program.cs" />
    <Compile Remove="RuntimeBootstrap.cs" />
    <EmbeddedResource Include="DeepSeekHarness.ico" LogicalName="AppIcon.ico" />
    <EmbeddedResource Include="assets\DeepSeek-icon.png" LogicalName="AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>
</Project>
